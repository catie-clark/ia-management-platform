SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional local-development workaround for corporate/self-signed TLS interception.
# Never enable this in production.
# SUPABASE_TLS_INSECURE=true
# Server-only secret. Configure this in Vercel for Preview/Production and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only secret for the Claude API. When unset, AI drafting features fall back to deterministic templates.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL=claude-opus-4-8
